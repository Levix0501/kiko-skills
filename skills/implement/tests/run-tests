#!/usr/bin/env bash
# Behavioral and stable-interface tests for the implement skill.
set -u

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
SKILL="$HERE/../SKILL.md"
SCRIPTS="$HERE/../scripts"
REFERENCES="$HERE/../references"
CHECK_KIKO="$SCRIPTS/check-kiko"
PREPARE_DIR="$SCRIPTS/prepare-implement-dir"
SETUP_KIKO="$HERE/../../setup-kiko/scripts/init-kiko"
KICK_CHECK="$HERE/../../kick-off/scripts/check-kiko"
CREATE_CHECK="$HERE/../../create-spec/scripts/check-kiko"
README="$HERE/../../../README.md"

TEST_TMP=$(mktemp -d "${TMPDIR:-/tmp}/implement-tests.XXXXXX")
TEST_TMP=$(CDPATH= cd -- "$TEST_TMP" && pwd -P)
trap 'rm -rf "$TEST_TMP"' EXIT

PASS=0
FAIL=0

pass() { PASS=$((PASS + 1)); printf 'ok   %s\n' "$1"; }
fail() { FAIL=$((FAIL + 1)); printf 'FAIL %s\n' "$1"; }
contains() { grep -qF -- "$2" "$1"; }
not_contains() { ! grep -qF -- "$2" "$1"; }

new_repo() {
  path=$1
  mkdir -p "$path"
  git -C "$path" init -q -b main
  git -C "$path" config user.name test
  git -C "$path" config user.email test@example.com
}

run_rc() {
  expected=$1
  shift
  rc=0
  "$@" >/dev/null 2>&1 || rc=$?
  [ "$rc" -eq "$expected" ]
}

t01_resource_layout() {
  [ -x "$CHECK_KIKO" ] || return 1
  [ -x "$PREPARE_DIR" ] || return 1
  [ "$(find "$SCRIPTS" -maxdepth 1 -type f | wc -l | tr -d ' ')" -eq 2 ] || return 1
  [ "$(find "$REFERENCES" -maxdepth 1 -type f -name '*.md' | wc -l | tr -d ' ')" -eq 6 ] || return 1
  [ -f "$REFERENCES/finding-gate.md" ] || return 1
  [ -f "$REFERENCES/spec-amendment.md" ]
}

t02_check_kiko_is_shared_and_builds_are_optional() {
  cmp -s "$CHECK_KIKO" "$KICK_CHECK" || return 1
  cmp -s "$CHECK_KIKO" "$CREATE_CHECK" || return 1

  root="$TEST_TMP/check-layout"
  new_repo "$root"
  kiko=$($SETUP_KIKO "$root") || return 1
  [ "$kiko" = "$root/.kiko" ] || return 1
  [ ! -e "$root/.kiko/builds" ] || return 1
  [ -z "$(git -C "$root" status --porcelain=v1 -uall)" ] || return 1
  [ "$($CHECK_KIKO "$root")" = "$root/.kiko" ] || return 1

  mkdir "$root/.kiko/builds"
  printf 'historical\n' >"$root/.kiko/builds/old.md"
  $SETUP_KIKO "$root" >/dev/null || return 1
  [ "$(cat "$root/.kiko/builds/old.md")" = historical ] || return 1
  $CHECK_KIKO "$root" >/dev/null
}

t03_check_kiko_exit_codes() {
  missing="$TEST_TMP/missing-layout"
  mkdir -p "$missing"
  run_rc 3 "$CHECK_KIKO" "$missing" || return 1

  incomplete="$TEST_TMP/incomplete-layout"
  mkdir -p "$incomplete/.kiko/specs" "$incomplete/.kiko/.implement"
  printf '# TODO\n' >"$incomplete/.kiko/TODO.md"
  run_rc 3 "$CHECK_KIKO" "$incomplete" || return 1

  wrong="$TEST_TMP/wrong-layout"
  mkdir -p "$wrong"
  printf 'not a directory\n' >"$wrong/.kiko"
  run_rc 2 "$CHECK_KIKO" "$wrong"
}

t04_prepare_dir_uses_complete_dated_slug() {
  root="$TEST_TMP/prepare"
  new_repo "$root"
  $SETUP_KIKO "$root" >/dev/null || return 1
  spec="$root/.kiko/specs/2026-08-26-payment-webhook.md"
  printf '# Spec\n' >"$spec"

  output=$($PREPARE_DIR "$root/.kiko" "$spec") || return 1
  expected="$root/.kiko/.implement/2026-08-26-payment-webhook"
  [ "$output" = "$expected" ] || return 1
  for child in scopes dispatch results decisions; do
    [ -d "$expected/$child" ] || return 1
  done
  [ ! -e "$expected/progress.md" ] || return 1
  [ "$($PREPARE_DIR "$root/.kiko" "$spec")" = "$expected" ]
}

t05_prepare_dir_rejects_ambiguous_specs() {
  root="$TEST_TMP/prepare-invalid"
  new_repo "$root"
  $SETUP_KIKO "$root" >/dev/null || return 1

  for name in example.md 2026-08-26-.md 2026-8-26-topic.md 26-08-26-topic.md; do
    printf '# Spec\n' >"$root/.kiko/specs/$name"
    run_rc 2 "$PREPARE_DIR" "$root/.kiko" "$root/.kiko/specs/$name" || return 1
  done

  mkdir "$root/.kiko/specs/nested"
  printf '# Spec\n' >"$root/.kiko/specs/nested/2026-08-26-valid.md"
  run_rc 2 "$PREPARE_DIR" "$root/.kiko" "$root/.kiko/specs/nested/2026-08-26-valid.md"
}

t06_role_output_interfaces_are_complete() {
  for contract in "$REFERENCES/implementer.md" "$REFERENCES/fixer.md"; do
    contains "$contract" '# Evidence' || return 1
    contains "$contract" 'Status: DONE|BLOCKED' || return 1
    contains "$contract" 'END_REPOSITORY' || return 1
    contains "$contract" 'Evidence-complete: yes' || return 1
  done

  for contract in "$REFERENCES/reviewer.md" "$REFERENCES/re-reviewer.md"; do
    contains "$contract" 'Status: clean|issues' || return 1
    contains "$contract" 'Result-complete: yes' || return 1
    contains "$contract" 'addressed|invalid|not_addressed | <' || return 1
    contains "$contract" '<every current Requirement and Acceptance ID or exact name, in spec order>' || return 1
  done
}

t07_cross_role_protocol_is_consistent() {
  spec_issue='a false codebase/API/platform premise in it, or an acceptance rule that cannot determine correctness'
  for role in implementer reviewer fixer re-reviewer; do
    contract="$REFERENCES/$role.md"
    contains "$contract" "$spec_issue" || return 1
    contains "$contract" 'do not create Output' || return 1
    contains "$contract" 'ERROR: dirty repository: <path>' || return 1
    contains "$contract" 'ERROR: moved repository: <path>' || return 1
  done
  contains "$SKILL" 'reporting a dirty or moved repository' || return 1
  contains "$SKILL" 'A second consecutive protocol failure at the same dispatch step' || return 1
  contains "$SKILL" 'with no Head advanced, it is confirmed as well' || return 1
  [ "$(grep -cF "never route the result's lower-priority conclusions directly" "$SKILL")" -eq 3 ] || return 1

  branch_rule="creating it from the repository's current branch on first touch"
  contains "$SKILL" "$branch_rule" || return 1
  contains "$REFERENCES/implementer.md" "$branch_rule" || return 1
  contains "$REFERENCES/fixer.md" "$branch_rule" || return 1
  contains "$SKILL" 'Created from' || return 1
  contains "$REFERENCES/implementer.md" 'Created from:' || return 1
  contains "$REFERENCES/fixer.md" 'Created from:' || return 1
  dirty_scope='after that, a dirty tree you cannot clear is a `Blocker`'
  contains "$REFERENCES/implementer.md" "$dirty_scope" || return 1
  contains "$REFERENCES/fixer.md" "$dirty_scope" || return 1
  contains "$SKILL" 'or the branch the user names where no adopted evidence records it' || return 1

  write_successor='after a code blocker, an external blocker, or a rejected spec issue'
  contains "$SKILL" "$write_successor" || return 1
  contains "$REFERENCES/implementer.md" "$write_successor" || return 1
  contains "$REFERENCES/fixer.md" "$write_successor" || return 1
  read_successor='after an external blocker or a rejected spec issue'
  contains "$REFERENCES/reviewer.md" "$read_successor" || return 1
  contains "$REFERENCES/re-reviewer.md" "$read_successor" || return 1
  for contract in "$REFERENCES/reviewer.md" "$REFERENCES/re-reviewer.md"; do
    contains "$contract" 'remove anything a check leaves behind' || return 1
    contains "$contract" 'Finding text may contain `|`' || return 1
  done

  contains "$REFERENCES/reviewer.md" 'REVIEW_TARGET' || return 1
  contains "$REFERENCES/re-reviewer.md" 'REREVIEW_TARGET' || return 1
  contains "$REFERENCES/reviewer.md" 'First finding ID' || return 1
  contains "$REFERENCES/re-reviewer.md" 'First finding ID' || return 1
  contains "$REFERENCES/re-reviewer.md" 'in `Finding sources` order'
}

t08_conditional_references_are_linked_and_complete() {
  contains "$SKILL" '[references/finding-gate.md](references/finding-gate.md)' || return 1
  contains "$SKILL" '[references/spec-amendment.md](references/spec-amendment.md)' || return 1
  not_contains "$SKILL" 'references/recovery.md' || return 1

  contains "$REFERENCES/finding-gate.md" '`Fix again`, `Accept risk`, and `Incomplete`' || return 1
  contains "$REFERENCES/finding-gate.md" 'a Critical or Important finding, or on a final phase' || return 1
  contains "$REFERENCES/finding-gate.md" 'Phase P<n>: risk acceptance — decisions/<name>.md' || return 1
  contains "$REFERENCES/spec-amendment.md" 'Decided by: controller|user' || return 1
  contains "$REFERENCES/spec-amendment.md" '(../SKILL.md#successor-fields)' || return 1
  contains "$REFERENCES/spec-amendment.md" 'Spec amendment — decisions/<name>.md'
}

t09_removed_protocol_does_not_return() {
  for path in "$SKILL" "$REFERENCES"/*.md; do
    not_contains "$path" 'DONE_WITH_CONCERNS' || return 1
    not_contains "$path" 'Manifest-complete: yes' || return 1
    not_contains "$path" 'review-package' || return 1
    not_contains "$path" 'BUILD_FILE' || return 1
    not_contains "$path" 'Repository authorization' || return 1
    not_contains "$path" 'First new finding ID' || return 1
    not_contains "$path" 'Prior review result' || return 1
    not_contains "$path" 'validate-progress' || return 1
    not_contains "$path" 'recovery.md' || return 1
  done
  not_contains "$SKILL" 'there is no automatic Minor-only round 2.' || return 1
  not_contains "$SKILL" 'Files absent from progress are orphans'
}

t10_readme_quickstart_and_setup_scripts() {
  not_contains "$SETUP_KIKO" 'mkdir -p "$kiko_dir/specs" "$kiko_dir/builds"' || return 1
  not_contains "$KICK_CHECK" 'require dir "$candidate/builds"' || return 1
  not_contains "$CREATE_CHECK" 'require dir "$candidate/builds"' || return 1
  not_contains "$CHECK_KIKO" 'require dir "$candidate/builds"' || return 1
  contains "$README" 'npx skills add Levix0501/kiko-skills' || return 1
  for command in /setup-kiko /kick-off /create-spec /implement; do
    contains "$README" "$command" || return 1
  done
}

t11_dispatch_manifests_supply_contract_preflights() {
  for role in implementer reviewer fixer re-reviewer; do
    contains "$SKILL" "Role: $role" || return 1
    contains "$REFERENCES/$role.md" "\`Role: $role\`" || return 1
  done

  for line in 'Mode: intermediate|final' 'Spec: $SPEC_FILE' 'Scope: <current-scope-absolute-path>' 'Output: $IMPLEMENT_DIR/results/<name>.md'; do
    contains "$SKILL" "$line" || return 1
  done
  for role in implementer reviewer fixer re-reviewer; do
    contract="$REFERENCES/$role.md"
    contains "$contract" '`Mode: intermediate|final`' || return 1
    contains "$contract" 'absolute Spec, Scope and Output paths' || return 1
    contains "$contract" '`Prior result`' || return 1
    contains "$contract" 'Prior disposition: spec-issue-rejected' || return 1
  done

  contains "$SKILL" 'Action: execute' || return 1
  contains "$SKILL" 'Branch: kiko/$SPEC_SLUG' || return 1
  for contract in "$REFERENCES/implementer.md" "$REFERENCES/fixer.md"; do
    contains "$contract" '`Action: execute|evidence-recovery`' || return 1
    contains "$contract" '`Recovery evidence`' || return 1
  done

  contains "$SKILL" 'Evidence sources:' || return 1
  contains "$SKILL" 'Finding sources:' || return 1
  contains "$SKILL" 'First finding ID: F<n>' || return 1
  contains "$SKILL" 'Reviewed head: <full-sha>' || return 1
  [ "$(grep -cF "list the current phase's adopted evidence, DONE and BLOCKED alike" "$SKILL")" -eq 3 ] || return 1
  [ "$(grep -cF 'per repository any adopted evidence reports' "$SKILL")" -eq 2 ] || return 1

  contains "$SKILL" 'Prior result: <absolute-result-path>' || return 1
  contains "$SKILL" 'Recovery evidence: <absolute-evidence-path>'
}

t12_skill_supporting_paths_exist() {
  for role in implementer reviewer fixer re-reviewer; do
    contains "$SKILL" "references/$role.md" || return 1
  done
  for path in $(grep -o 'references/[a-z-]*\.md' "$SKILL" | sort -u); do
    [ -f "$HERE/../$path" ] || return 1
  done
  for path in $(grep -o 'scripts/[a-z-]*' "$SKILL" | sort -u); do
    [ -f "$HERE/../$path" ] || return 1
  done
}

TESTS='t01_resource_layout
t02_check_kiko_is_shared_and_builds_are_optional
t03_check_kiko_exit_codes
t04_prepare_dir_uses_complete_dated_slug
t05_prepare_dir_rejects_ambiguous_specs
t06_role_output_interfaces_are_complete
t07_cross_role_protocol_is_consistent
t08_conditional_references_are_linked_and_complete
t09_removed_protocol_does_not_return
t10_readme_quickstart_and_setup_scripts
t11_dispatch_manifests_supply_contract_preflights
t12_skill_supporting_paths_exist'

for test_name in $TESTS; do
  if (set -e; "$test_name"); then
    pass "$test_name"
  else
    fail "$test_name"
  fi
done

printf '\n%s passed, %s failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
